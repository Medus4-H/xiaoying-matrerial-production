{
  "name": "xiaoying-studio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build",
    "test:run": "node --test test/*.test.mjs && vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.mjs\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.mjs\" \"vitest.config.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.16",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "msw": "2.11.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
