FROM node:22.14.0-bookworm-slim AS source
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
FROM source AS check
CMD ["npm", "run", "check"]
FROM source AS build
ARG BACKEND_INTERNAL_URL=http://backend:8080
ARG NEXT_PUBLIC_SHOW_SIMULATION_CONTROLS=false
ARG NEXT_PUBLIC_ERROR_LOCALE=zh-CN
ARG NEXT_PUBLIC_TASK_POLL_INTERVAL_MS=2000
ARG NEXT_PUBLIC_TASK_HISTORY_PAGE_SIZE=20
ARG NEXT_PUBLIC_TASK_QUERY_TIMEOUT_MS=10000
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_SHOW_SIMULATION_CONTROLS=$NEXT_PUBLIC_SHOW_SIMULATION_CONTROLS
ENV NEXT_PUBLIC_ERROR_LOCALE=$NEXT_PUBLIC_ERROR_LOCALE
ENV NEXT_PUBLIC_TASK_POLL_INTERVAL_MS=$NEXT_PUBLIC_TASK_POLL_INTERVAL_MS
ENV NEXT_PUBLIC_TASK_HISTORY_PAGE_SIZE=$NEXT_PUBLIC_TASK_HISTORY_PAGE_SIZE
ENV NEXT_PUBLIC_TASK_QUERY_TIMEOUT_MS=$NEXT_PUBLIC_TASK_QUERY_TIMEOUT_MS
RUN npm run build
FROM node:22.14.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
