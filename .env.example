# 唯一环境配置入口。复制为 .env；直接 docker compose up --build 也可使用本地演示默认值。
COMPOSE_PROJECT_NAME=xiaoying-studio
FRONTEND_PORT=3000
# 留空时按 FRONTEND_PORT 生成本地来源；部署 HTTPS/域名时设成实际站点地址。
# PUBLIC_ORIGIN=https://your-domain.example
APP_PROFILE=demo
# 是否在模板制作页面显示模拟失败选项；修改后需重新构建前端。
NEXT_PUBLIC_SHOW_SIMULATION_CONTROLS=false
# 未完成任务轮询间隔（毫秒）；修改后需重新构建前端。
NEXT_PUBLIC_TASK_POLL_INTERVAL_MS=2000
# 每页历史任务数（1–50）；修改后需重新构建前端。
NEXT_PUBLIC_TASK_HISTORY_PAGE_SIZE=20
# 单次任务查询超时（毫秒）；修改后需重新构建前端。
NEXT_PUBLIC_TASK_QUERY_TIMEOUT_MS=10000
MYSQL_IMAGE=mysql:8.4.7
MYSQL_DATABASE=studio
MYSQL_USER=studio
MYSQL_PASSWORD=local-demo-only
MYSQL_ROOT_PASSWORD=local-root-only
# 仅 demo 模式的模拟验证码，不会发送短信或邮件。
AUTH_DEMO_CODE=123456
AUTH_PASSWORD_ITERATIONS=210000
# Cookie 名称前缀，Compose 自动附加 FRONTEND_PORT；旧名称用于兼容有效旧会话。
SESSION_COOKIE_NAME=studio_session
# 默认与 SESSION_COOKIE_NAME 相同；仅从不同旧名称升级时需要设置。
# SESSION_LEGACY_COOKIE_NAME=studio_session
SESSION_MIGRATION_MARKER_TTL_SECONDS=34560000
SESSION_TTL=7d
SESSION_SECURE=false
# 仅容器内部使用，不会返回浏览器。变更后需重新构建前端。
BACKEND_INTERNAL_URL=http://backend:8080

# 素材服务器限制；请保持 multipart 限制不低于素材限制。
ASSET_MAX_BYTES=5242880
ASSET_MAX_DIMENSION=8192
ASSET_MAX_PIXELS=16000000
ASSET_MULTIPART_FILE_LIMIT=5MB
ASSET_MULTIPART_REQUEST_LIMIT=6MB

# 后台模拟阶段的默认耗时和单阶段上限（毫秒）
TASK_ASSET_CHECK_DELAY_MS=1000
TASK_GENERATE_DELAY_MS=6000
TASK_FINALIZE_DELAY_MS=1000
TASK_MAX_DELAY_MS=30000
TASK_CONCURRENCY=2
TASK_QUEUE_CAPACITY=20
TASK_SHUTDOWN_GRACE_SECONDS=30
# 应长于任务执行器的等待时间，超过后仍可能中断未完成任务。
TASK_CONTAINER_STOP_GRACE=40s

# Error-message language (zh-CN or en); rebuild the frontend after changing it.
NEXT_PUBLIC_ERROR_LOCALE=zh-CN

# 后端日志格式、业务日志级别、慢请求阈值（毫秒）与容器日志轮转。
LOG_CONSOLE_FORMAT=ecs
LOG_LEVEL=INFO
LOG_SLOW_REQUEST_MS=500
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# 诊断默认关闭；开启时请通过未提交的环境变量 DIAGNOSTICS_SECRET 提供独立强凭据。
FRONTEND_BIND_ADDRESS=0.0.0.0
METRICS_JVM_ENABLED=false
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_CAPACITY=500
DIAGNOSTICS_MAX_EVENT_BYTES=2048
DIAGNOSTICS_SESSION_TTL_SECONDS=900
